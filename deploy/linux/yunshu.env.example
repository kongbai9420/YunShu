# 云枢运维平台配置文件（Linux：/etc/yunshu/yunshu.env）
# Yunshu ops platform configuration (Linux: /etc/yunshu/yunshu.env)
#
# 每行 KEY=VALUE，# 开头为注释；不做变量展开。systemd 单元（EnvironmentFile=）与 yunshu 命令都读这个文件，
# 进程里已有的环境变量优先。修改后执行：sudo systemctl restart yunshu-api（独立 Worker 时再重启 yunshu-worker）。
# One KEY=VALUE per line, no variable expansion. Restart the services after editing.
#
# install.sh 只在 /etc/yunshu/yunshu.env 不存在时写入本文件；升级不会覆盖你的修改，
# 新版本的示例另存为 /etc/yunshu/yunshu.env.example 供对照。

# ---- 目录 / Paths -------------------------------------------------------------
# 数据库（SQLite）与平台备份（backups/）
YUNSHU_DATA_DIR=/var/lib/yunshu
# 主密钥：加密已保存的设备密码。必须放在数据目录以外，并单独备份（备份文件里不含主密钥）
# Master key: must live outside the data dir and be backed up separately.
YUNSHU_MASTER_KEY_FILE=/etc/yunshu/keys/master.key
# 日志除了写入 journald，还写到这个目录（每个文件 10 MB，保留 5 个）
YUNSHU_LOG_DIR=/var/log/yunshu

# ---- 监听 / Listen ------------------------------------------------------------
YUNSHU_BIND=0.0.0.0
YUNSHU_PORT=8080

# ---- 轻量版（默认）：SQLite + 内嵌 Worker / Lite (default): SQLite + embedded worker
# 数据库默认为 $YUNSHU_DATA_DIR/yunshu.db；API 启动时如需升级结构，会先备份再升级。
YUNSHU_EMBEDDED_WORKER=1
# 已在这里选定数据库，不显示首次设置向导
YUNSHU_SETUP_WIZARD=0

# ---- 标准版：外部 PostgreSQL 16 / 17 + 独立 Worker / Standard: external PostgreSQL + separate worker
# 1. 填写连接串，并把 YUNSHU_EMBEDDED_WORKER 改为 0
# 2. sudo yunshu migrate（或 sudo systemctl start yunshu-migrate）
# 3. sudo systemctl enable --now yunshu-migrate yunshu-api yunshu-worker
# 详见 /opt/yunshu/current/README.txt 与部署文档。
#YUNSHU_DATABASE_URL=postgresql+psycopg://yunshu:fake-change-me@db.example.invalid:5432/yunshu
#YUNSHU_EMBEDDED_WORKER=0
# pg_dump / pg_restore 所在目录（备份恢复 PostgreSQL 时用；不填则在 PATH 里找）
#YUNSHU_PG_BIN_DIR=/usr/lib/postgresql/17/bin
# 企业部署建议以数据库侧备份为准：关闭平台定时备份
#YUNSHU_BACKUP_INTERVAL_HOURS=0

# ---- 时区 / Time zone ---------------------------------------------------------
# 默认跟随主机时区（/etc/localtime）。只想让云枢用别的时区时再设置：
# Follows the host time zone by default.
#TZ=Asia/Shanghai

# ---- 反向代理与 HTTPS / Reverse proxy and HTTPS --------------------------------
# 经 HTTPS 反向代理访问时设为 1，会话 Cookie 只走 HTTPS
YUNSHU_SECURE_COOKIES=0
# 反向代理不在本机时，填代理的地址，才能记录真实客户端地址（未设置时只信任 127.0.0.1）
#FORWARDED_ALLOW_IPS=192.0.2.10
# 代理在本机时一般改为只监听本机：
#YUNSHU_BIND=127.0.0.1

# ---- SNMP Trap 接收（默认关闭）/ SNMP trap receiver (off by default) -----------
# 监听 UDP 1162（不需要特权端口）；BMC 只会发往 162，请在主机上把 UDP 162 转到 1162（见部署文档）
#YUNSHU_SNMP_TRAP=1
#YUNSHU_SNMP_TRAP_PORT=1162
# BMC 上配置的 Trap 目标地址（本机对 BMC 可达的地址）
#YUNSHU_SNMP_TRAP_TARGET=192.0.2.20
